{
	"display_information": {
		"name": "Casper",
		"description": "Pi session bridge that mirrors local sessions into Slack channels."
	},
	"features": {
		"bot_user": {
			"display_name": "Casper",
			"always_online": false
		},
		"slash_commands": [
			{
				"command": "/casper",
				"url": "https://example.com/slack/message_action",
				"description": "Control Casper and route commands to pi sessions.",
				"usage_hint": "status | casper-status | compact | stop | reload | skill:name instructions",
				"should_escape": false
			}
		]
	},
	"oauth_config": {
		"scopes": {
			"bot": [
				"app_mentions:read",
				"channels:history",
				"channels:join",
				"channels:manage",
				"channels:read",
				"channels:write.invites",
				"commands",
				"chat:write",
				"chat:write.customize",
				"chat:write.public",
				"files:read",
				"files:write",
				"users:read"
			]
		},
		"pkce_enabled": false
	},
	"settings": {
		"event_subscriptions": {
			"bot_events": [
				"app_mention",
				"message.channels"
			]
		},
		"interactivity": {
			"is_enabled": true
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": true,
		"token_rotation_enabled": false,
		"is_mcp_enabled": false
	}
}
