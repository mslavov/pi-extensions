{
	"display_information": {
		"name": "Casper",
		"description": "Pi session bridge that mirrors local sessions into Slack channels."
	},
	"features": {
		"bot_user": {
			"display_name": "Casper",
			"always_online": false
		}
	},
	"oauth_config": {
		"scopes": {
			"bot": [
				"app_mentions:read",
				"channels:history",
				"channels:join",
				"channels:manage",
				"channels:read",
				"channels:write.invites",
				"chat:write",
				"files:read"
			]
		},
		"pkce_enabled": false
	},
	"settings": {
		"event_subscriptions": {
			"bot_events": [
				"app_mention",
				"message.channels"
			]
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": true,
		"token_rotation_enabled": false,
		"is_mcp_enabled": false
	}
}
